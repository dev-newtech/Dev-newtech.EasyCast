//@version=5
// ============================================================================
//  Stratégie de test : balayage de liquidité (ICT / SMC)
//  À utiliser dans le « Testeur de stratégie » de TradingView avant le réel.
//
//  Idée : les plus hauts / plus bas de la veille (HPD / LPD) et du range Asie
//  (H-Asia / L-Asia) concentrent des stops. Quand le prix « balaie » un de ces
//  niveaux (mèche au-delà puis clôture de retour à l'intérieur), on prend la
//  position inverse :
//   - balayage d'un bas (LPD / L-Asia)  → achat
//   - balayage d'un haut (HPD / H-Asia) → vente
//  Stop : au-delà de la mèche du balayage (+ marge en ATR).
//  Objectif : ratio risque / rendement fixe (RR).
// ============================================================================
strategy("Stratégie Balayage de liquidité (ICT / SMC)", shorttitle = "Sweep Strategy", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 2,
     process_orders_on_close = true)

// ─── Réglages ───────────────────────────────────────────────────────────────
grpL       = "Niveaux de liquidité"
useHPDLPD  = input.bool(true, "Trader les balayages de HPD / LPD", group = grpL)
useAsia    = input.bool(true, "Trader les balayages de H-Asia / L-Asia", group = grpL)
asiaSess   = input.session("0000-0600", "Plage horaire Asie (heure de Paris)", group = grpL)

grpT       = "Gestion du trade"
rr         = input.float(2.0, "Ratio risque / rendement (RR)", minval = 0.5, step = 0.5, group = grpT)
slBufAtr   = input.float(0.1, "Marge du stop au-delà de la mèche (× ATR)", minval = 0, step = 0.05, group = grpT)
confirm    = input.bool(true, "Exiger une bougie de confirmation (clôture dans le sens du trade)", group = grpT)
maxTrades  = input.int(2, "Nombre max de trades par jour", minval = 1, group = grpT)

grpW       = "Fenêtre de trading (killzones ICT)"
tradeSess  = input.session("0800-1700", "Fenêtre de trading (heure de Paris)", group = grpW,
     tooltip = "Par défaut : de l'ouverture de Londres à la fin de la matinée de New York.")
closeOut   = input.bool(true, "Clôturer la position en fin de fenêtre", group = grpW)

// ─── Niveaux ────────────────────────────────────────────────────────────────
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

inAsia = not na(time(timeframe.period, asiaSess, "Europe/Paris"))
var float aH = na
var float aL = na
if inAsia and not inAsia[1]
    aH := high
    aL := low
else if inAsia
    aH := math.max(aH, high)
    aL := math.min(aL, low)
asiaDone = not inAsia and not na(aH)

// ─── Signaux de balayage ────────────────────────────────────────────────────
sweepHigh(float lvl) => not na(lvl) and high > lvl and close < lvl
sweepLow(float lvl)  => not na(lvl) and low < lvl and close > lvl

newDay = timeframe.change("D")
var int  tradesToday = 0
var bool usedHPD = false
var bool usedLPD = false
var bool usedHA  = false
var bool usedLA  = false
if newDay
    tradesToday := 0
    usedHPD := false
    usedLPD := false
    usedHA  := false
    usedLA  := false

inWin = not na(time(timeframe.period, tradeSess, "Europe/Paris"))
atr   = ta.atr(14)

lLPD = useHPDLPD and not usedLPD and sweepLow(pdL)
lLA  = useAsia and asiaDone and not usedLA and sweepLow(aL)
sHPD = useHPDLPD and not usedHPD and sweepHigh(pdH)
sHA  = useAsia and asiaDone and not usedHA and sweepHigh(aH)

canTrade = inWin and strategy.position_size == 0 and tradesToday < maxTrades
goLong   = canTrade and (lLPD or lLA) and (not confirm or close > open)
goShort  = canTrade and (sHPD or sHA) and (not confirm or close < open) and not goLong

// ─── Ordres ─────────────────────────────────────────────────────────────────
if goLong
    sl = low - atr * slBufAtr
    tp = close + rr * (close - sl)
    strategy.entry("Long", strategy.long, comment = lLPD ? "Sweep LPD" : "Sweep L-Asia")
    strategy.exit("Sortie Long", "Long", stop = sl, limit = tp)
    tradesToday += 1
    usedLPD := usedLPD or lLPD
    usedLA  := usedLA or lLA

if goShort
    sl = high + atr * slBufAtr
    tp = close - rr * (sl - close)
    strategy.entry("Short", strategy.short, comment = sHPD ? "Sweep HPD" : "Sweep H-Asia")
    strategy.exit("Sortie Short", "Short", stop = sl, limit = tp)
    tradesToday += 1
    usedHPD := usedHPD or sHPD
    usedHA  := usedHA or sHA

if closeOut and not inWin and strategy.position_size != 0
    strategy.close_all(comment = "Fin de fenêtre")

// ─── Affichage des niveaux ─────────────────────────────────────────────────
plot(pdH, "HPD", color.red, style = plot.style_linebr)
plot(pdL, "LPD", color.red, style = plot.style_linebr)
plot(asiaDone ? aH : na, "H-Asia", color.gray, style = plot.style_linebr)
plot(asiaDone ? aL : na, "L-Asia", color.gray, style = plot.style_linebr)
bgcolor(inWin ? color.new(color.blue, 94) : na, title = "Fenêtre de trading")
